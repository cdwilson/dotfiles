theme = cdwilson-tomorrow-night
font-family = Monaspace Neon
{{- if eq .chezmoi.os "darwin" }}
font-size = 14
{{- else if eq .chezmoi.os "linux" }}
font-size = 11
{{- end }}
cursor-style = bar
cursor-click-to-move = true
adjust-cell-height = 20%
clipboard-paste-protection = true
window-width = 80
window-height = 24
{{- if eq .chezmoi.os "darwin" }}
  {{- /* Ghostty starts the shell with launchd's minimal PATH, so a full path is
         required. Prefer the MacPorts bash when MacPorts is installed (Intel
         Macs, since Homebrew 7.0 dropped Intel support); otherwise fall back to
         the Homebrew bash for this architecture. */}}
  {{- if stat "/opt/local/bin/bash" }}
command = /opt/local/bin/bash --login
  {{- else if eq .chezmoi.arch "arm64" }}
command = /opt/homebrew/bin/bash --login
  {{- else }}
command = /usr/local/bin/bash --login
  {{- end }}
{{- else if eq .chezmoi.os "linux" }}
command = /bin/bash --login
{{- end }}
